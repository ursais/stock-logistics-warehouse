<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="silo_movement_report_wizard_form" model="ir.ui.view">
        <field name="name">silo.movement.report.wizard.form</field>
        <field name="model">silo.movement.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Reporte de Movimientos de Silo">
                <group>
                    <group string="Período">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group string="Filtros">
                        <field name="location_ids" widget="many2many_tags"/>
                        <field name="product_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <group>
                    <group string="Opciones">
                        <field name="show_validated_only"/>
                        <field name="show_quarantine"/>
                        <field name="group_by_silo"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_report" string="Imprimir PDF" type="object" class="btn-primary"/>
                    <button name="action_view_movements" string="Ver Movimientos" type="object" class="btn-secondary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_silo_movement_report_wizard" model="ir.actions.act_window">
        <field name="name">Reporte Movimientos de Silo</field>
        <field name="res_model">silo.movement.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
