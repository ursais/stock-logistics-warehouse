<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="view_stock_inventory_report_wizard_form" model="ir.ui.view">
        <field name="name">stock.inventory.report.wizard.form</field>
        <field name="model">stock.inventory.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Reporte de Existencias">
                <group>
                    <group string="Período">
                        <field name="date_from" />
                        <field name="date_to" />
                    </group>
                    <group string="Opciones">
                        <field name="show_quality_data" />
                        <field name="show_consumption_data" />
                    </group>
                </group>
                <group>
                    <group string="Filtros">
                        <field name="location_ids" widget="many2many_tags" />
                        <field name="product_ids" widget="many2many_tags" />
                    </group>
                </group>
                <footer>
                    <button
                        name="action_print_report"
                        string="Imprimir Reporte"
                        type="object"
                        class="btn-primary"
                    />
                    <button
                        name="action_view_lots"
                        string="Ver Macrolotes"
                        type="object"
                        class="btn-secondary"
                    />
                    <button string="Cancelar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open wizard -->
    <record id="action_stock_inventory_report_wizard" model="ir.actions.act_window">
        <field name="name">Reporte de Existencias</field>
        <field name="res_model">stock.inventory.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Item -->
    <menuitem
        id="menu_stock_inventory_report"
        name="Reporte Existencias Silos"
        parent="stock.menu_warehouse_report"
        action="action_stock_inventory_report_wizard"
        sequence="20"
    />

</odoo>
